<!-- pages/design/design.js -->
const fabric = require('../../libs/fabric.js');
Page({
  data: {
    materials: [],
    currentRecommend: ''
  },

  onReady() {
    this.initCanvas();
    this.loadMaterials();
  },

  initCanvas() {
    this.canvas = new fabric.Canvas('designCanvas', {
      width: 300,
      height: 400
    });
  },

  loadMaterials() {
    wx.cloud.callFunction({
      name: 'getMaterials',
      success: res => {
        this.setData({ materials: res.result.data });
      }
    });
  },

  selectMaterial(e) {
    const id = e.currentTarget.dataset.id;
    const material = this.data.materials.find(item => item.id === id);
    
    fabric.Image.fromURL(material.url, img => {
      img.scale(0.5);
      this.canvas.add(img);
      this.canvas.renderAll();
    });
  }
});

<!-- 云函数getMaterials -->
const cloud = require('wx-server-sdk');
cloud.init();
const db = cloud.database();

exports.main = async () => {
  return await db.collection('materials')
    .where({ status: 1 })
    .orderBy('createTime', 'desc')
    .get();
};

