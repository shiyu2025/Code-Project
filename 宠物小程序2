<!-- 微信支付示例 -->
async function payOrder(orderId) {
  const res = await wx.cloud.callFunction({
    name: 'createPayment',
    data: { orderId }
  });
  
  wx.requestPayment({
    timeStamp: res.timeStamp,
    nonceStr: res.nonceStr,
    package: res.package,
    signType: 'MD5',
    paySign: res.paySign,
    success: () => {
      wx.showToast({ title: '支付成功' });
    }
  });
}
