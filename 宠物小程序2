// Redis缓存加速
const redis = require('redis');
const client = redis.createClient();

async function updateRank(userId, score) {
  await client.zadd('weekly_rank', score, userId);
  return client.zrevrange('weekly_rank', 0, 9, 'WITHSCORES');
}
```

